# =================================================================
# AI GatewayOps - Environment Configuration Template
# =================================================================
# Copy this file to .env in respective apps or root for local dev.
# NEVER commit the actual .env file or real secrets to version control.

# --- NODE ENVIRONMENT ---
NODE_ENV=development

# --- PLATFORM API (Backend for SaaS Management) ---
PLATFORM_PORT=5000
PLATFORM_URL=http://localhost:5000

# --- GATEWAY (Proxy & Telemetry Ingestion) ---
GATEWAY_PORT=8000
GATEWAY_URL=http://localhost:8000

# --- DASHBOARD (React + Vite Frontend) ---
VITE_PLATFORM_API_URL=http://localhost:5000/api
VITE_GATEWAY_URL=http://localhost:8000

# --- DATABASE (MongoDB) ---
# Single MongoDB connection string for local dev or MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017/ai_gatewayops

# --- AUTHENTICATION & TOKENS ---
# JWT secret for access tokens (short-lived, e.g., 15m)
JWT_ACCESS_SECRET=your_jwt_access_secret_here_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m

# JWT secret for refresh tokens (longer-lived, e.g., 7d)
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# --- AI PROVIDER (Google Gemini) ---
# Provider selection: 'gemini' | 'openai' (future) | 'mock'
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- RATE LIMITING (Gateway In-Memory Defaults) ---
DEFAULT_RATE_LIMIT_WINDOW_MS=60000
DEFAULT_RATE_LIMIT_MAX=100

# --- CORS SETTINGS ---
CORS_ORIGIN=http://localhost:3000
